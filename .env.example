# .env.example — copy to .env and edit to override compose defaults.
# None of these are required: the compose file ships sensible defaults.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=catalog

# ── LocalStack / AWS ──────────────────────────────────────────────────────────
# Use the defaults below for local development with LocalStack.
# Replace with real AWS credentials and remove AWS_ENDPOINT_URL
# if targeting a real S3 bucket.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
PRODUCT_IMAGE_BUCKET_NAME=product-images

# ── Service ports (host-side) ─────────────────────────────────────────────────
APP_PORT=3000         # Catalog API
WEBAPP_PORT=5173      # Demo web client (nginx)
PGADMIN_PORT=5050     # pgAdmin 4          (--profile tools only)
KAFBAT_PORT=8080      # Kafbat Kafka UI    (--profile tools only)

# ── pgAdmin (tools profile only) ─────────────────────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=postgres
